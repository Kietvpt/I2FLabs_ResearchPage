{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/sse", "destination": "/api/sse" },
    { "source": "/messages", "destination": "/api/messages" },
    { "source": "/rpc", "destination": "/api/rpc" },
    { "source": "/mcp", "destination": "/api/rpc" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-session-id" }
      ]
    }
  ]
}

# Client-side (safe to expose when Supabase RLS is enabled)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
VITE_SITE_URL=http://localhost:5173

# Server-side only (NEVER prefix with VITE_ or import in src/)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key-here
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
